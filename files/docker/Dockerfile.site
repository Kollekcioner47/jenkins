# Образ сайта — практика 12.
#
# Куда класть: files/docker/Dockerfile.site в репозитории.
# Сборка (контекст — каталог build/docker-context, он готовится в конвейере):
#     docker build -f files/docker/Dockerfile.site -t 10.0.2.5:5000/lab-site:1 build/docker-context
#
# ЧТО ЗДЕСЬ ГЛАВНОЕ
#
# Базовый образ зафиксирован по версии (nginx:1.27-alpine), а не взят
# как nginx:latest. Тег latest означает «то, что сейчас в реестре»:
# сегодня это одна версия, завтра другая, а Dockerfile тот же.
# Сборка «вчера работала, сегодня нет» без единой правки — обычно
# именно про это.
#
# COPY кладёт только нужные файлы. Каталог целиком копировать нельзя:
# в образ уедут лишние файлы и, что хуже, они останутся в истории слоёв,
# даже если удалить их следующей командой.

FROM nginx:1.27-alpine

LABEL org.opencontainers.image.title="lab-site" \
      org.opencontainers.image.description="Статический сайт лаборатории CI/CD" \
      org.opencontainers.image.authors="Иван Климарев"

# Страница сайта и сведения о сборке.
COPY index.html      /usr/share/nginx/html/index.html
COPY build-info.txt  /usr/share/nginx/html/build-info.txt

# Конфигурация nginx по умолчанию отдаёт /usr/share/nginx/html — этого
# достаточно. Если понадобится своя, файл кладут в /etc/nginx/conf.d/:
# COPY site.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Проверка работоспособности на уровне образа. ВАЖНО понимать, что она
# делает и чего не делает: HEALTHCHECK только ВЫСТАВЛЯЕТ статус контейнера
# (healthy или unhealthy) и никого не перезапускает. Перезапуск делает
# ключ --restart при запуске контейнера и только тогда, когда процесс
# завершился. Зависший, но живой процесс сам не перезапустится: за это
# отвечает оркестратор, а не Docker.
# wget есть в alpine из коробки, curl пришлось бы ставить.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1

# Строки USER здесь нет намеренно. В официальном образе nginx мастер-процесс
# стартует от root, чтобы занять порт 80, а рабочие процессы работают
# от пользователя nginx. Для этого образа такой расклад — норма. Если нужен
# полностью непривилегированный вариант, берут nginx-unprivileged и слушают
# непривилегированный порт (например, 8080), пробрасывая его наружу.
