# Образ агента Jenkins — практика 12.
#
# Идея: инструменты сборки живут в образе, а не на сервере. Агент
# разворачивается из образа, отрабатывает и исчезает вместе с контейнером.
# Это и есть ответ на извечный вопрос «почему на node1 сборка проходит,
# а на node2 нет»: на node1 другая версия rsync.
#
# Сборка:
#     docker build -f files/docker/Dockerfile.agent -t 10.0.2.5:5000/jenkins-agent:1 .
# Публикация:
#     docker push 10.0.2.5:5000/jenkins-agent:1
#
# ПОЧЕМУ ОСНОВА — ОФИЦИАЛЬНЫЙ ОБРАЗ jenkins/inbound-agent
#
# В нём уже есть JRE, сам агент и правильный пользователь. Собирать это
# с нуля — значит повторять чужую работу и получать свои грабли: не тот
# уровень прав, не тот рабочий каталог, не тот способ подключения.
# Тег jdk21 фиксирует версию Java: агент должен уметь запускаться
# на контроллере нужной версии.

FROM jenkins/inbound-agent:jdk21

# Пакеты ставим от root, а возвращаемся к пользователю jenkins:
# процесс агента не должен выполняться от root.
USER root

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        rsync \
        curl \
        ca-certificates \
        openssh-client \
        git \
        jq \
 && rm -rf /var/lib/apt/lists/*

USER jenkins

# Рабочий каталог совпадает с remoteFS, который указывается при создании
# агента в Jenkins. Если не совпадёт, агент запустится, но сборки будут
# идти в каталог по умолчанию — и искать свои файлы вы будете не там.
WORKDIR /home/jenkins/agent
