/*
 * Jenkinsfile.simple — минимальный декларативный конвейер (практика 10).
 *
 * Задача файла: показать каркас, из которого потом собираются настоящие
 * конвейеры. Здесь нет ни выката, ни секретов — только структура
 * и то, что в этой структуре обязательно.
 *
 * Обратите внимание на три вещи, которые в прежней версии курса были
 * написаны с ошибками и не работали:
 *   agent any        — не «agent nay»: слово any зарезервировано;
 *   кавычки          — открывающая и закрывающая должны совпадать,
 *                      иначе Groovy не соберёт конвейер;
 *   steps            — команды живут ВНУТРИ steps, а не рядом со stage.
 * Всё остальное — оформление: options, environment, post.
 */

pipeline {
    // Где выполнять. any — на любом агенте; в практике 4 мы заменим это
    // на конкретную метку, чтобы сборки не шли на контроллере.
    agent any

    options {
        // Пять ограничений, которые стоит ставить почти всегда:
        timestamps()                                  // время у каждой строки лога
        timeout(time: 15, unit: 'MINUTES')            // зависший конвейер умрёт сам
        buildDiscarder(logRotator(numToKeepStr: '10'))// история не растёт бесконечно
        disableConcurrentBuilds()                     // две сборки не подерутся за каталог
        skipDefaultCheckout(true)                     // checkout делаем сами, явно
    }

    environment {
        // Переменные из этого блока видны всем стадиям. Здесь намеренно
        // только то, что не является секретом: значения отсюда попадают
        // в лог сборки открытым текстом.
        PROJECT_NAME = 'lab-site'
        SITE_DIR     = 'build/deploy/www'
    }

    stages {
        stage('1. Подготовка') {
            steps {
                echo "Конвейер запущен для проекта ${env.PROJECT_NAME}"
                echo "Агент: ${env.NODE_NAME}, каталог: ${env.WORKSPACE}"
                sh 'hostname; whoami; pwd'
            }
        }

        stage('2. Сборка') {
            steps {
                // Многострочный скрипт: одинарные тройные кавычки означают,
                // что Groovy не трогает ${...} — подстановку делает shell.
                sh '''
                    set -eu
                    mkdir -p build
                    date > build/build-stamp.txt
                    echo "файл собран" > build/artifact.txt
                    cat build/build-stamp.txt
                '''
            }
        }

        stage('3. Проверка') {
            steps {
                sh '''
                    set -eu
                    # Проверяем результат сборки, а не факт выполнения команд.
                    # Разница принципиальная: команда может отработать успешно
                    # и не создать то, что нужно.
                    test -f build/artifact.txt
                    grep -q "файл собран" build/artifact.txt
                    echo "проверка пройдена"
                '''
            }
        }
    }

    post {
        success {
            echo "Сборка ${env.BUILD_NUMBER} завершилась успешно"
        }
        unstable {
            echo "Сборка ${env.BUILD_NUMBER} нестабильна"
        }
        failure {
            echo "Сборка ${env.BUILD_NUMBER} провалилась: смотрите лог выше"
        }
        // always выполняется всегда, но РАНЬШЕ ветвей failure и success.
        // Для уборки за собой в декларативном конвейере есть отдельное
        // условие cleanup: оно выполняется самым последним, когда всё
        // остальное уже отработало.
        always {
            archiveArtifacts artifacts: 'build/**', allowEmptyArchive: true
        }
    }
}
