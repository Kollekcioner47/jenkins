<?xml version='1.0' encoding='UTF-8'?>
<!--
  Задание с расписанием (практика 7): раз в 15 минут печатает отчёт
  о состоянии стенда и хранит только последние сборки.

  Обратите внимание на расписание H/15 * * * *.
  Первая буква H — не опечатка и не «hour». Это хеш: Jenkins сам выбирает
  смещение внутри интервала, чтобы двадцать заданий с H/15 не стартовали
  одновременно. Разница видна сразу: двадцать заданий с */15 создадут
  пиковую нагрузку на Jenkins каждые 15 минут, а с H/15 — размажутся.

  Второй важный элемент — LogRotator. Без него история сборок растёт
  безгранично, и однажды заканчивается место на диске. Место кончается
  молча: сборки продолжают идти, а упавший выкат объясняют чем угодно,
  кроме диска.
-->
<project>
  <description>Периодический отчёт о состоянии стенда лаборатории.</description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <jenkins.model.BuildDiscarderProperty>
      <strategy class="hudson.tasks.LogRotator">
        <daysToKeep>7</daysToKeep>
        <numToKeep>50</numToKeep>
        <artifactDaysToKeep>-1</artifactDaysToKeep>
        <artifactNumToKeep>-1</artifactNumToKeep>
      </strategy>
    </jenkins.model.BuildDiscarderProperty>
  </properties>
  <scm class="hudson.scm.NullSCM"/>
  <canRoam>true</canRoam>
  <disabled>false</disabled>
  <blockBuildWhenDownstreamBuilding>false</blockBuildWhenDownstreamBuilding>
  <blockBuildWhenUpstreamBuilding>false</blockBuildWhenUpstreamBuilding>
  <triggers>
    <hudson.triggers.TimerTrigger>
      <spec>H/15 * * * *</spec>
    </hudson.triggers.TimerTrigger>
  </triggers>
  <concurrentBuild>false</concurrentBuild>
  <builders>
    <hudson.tasks.Shell>
      <command>set -eu

echo "Отчёт о состоянии стенда на $(date '+%Y-%m-%d %H:%M:%S %Z')"
echo "Агент: $(hostname) ($(hostname -I | awk '{print $1}'))"
echo
echo "Место на диске:"
df -h / | tail -n 1
echo
echo "Память:"
free -h | head -n 2
echo
echo "Служба Jenkins на контроллере:"
if curl -fsS --max-time 5 http://10.0.2.5:8080/api/json >/dev/null 2&gt;&amp;1; then
    echo "  портал отвечает"
else
    echo "  портал НЕ отвечает"
    exit 1
fi</command>
    </hudson.tasks.Shell>
  </builders>
  <publishers/>
  <buildWrappers/>
</project>
